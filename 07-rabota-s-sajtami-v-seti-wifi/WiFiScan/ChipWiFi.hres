        sizet=strlen(sarr[i+1]);
        if (sizet<16)
        {
          Serial.print(essid); Serial.print(" a=> ");  Serial.println(epassword);
          epassword[16] = {0};
          Serial.print(essid); Serial.print(" b=> ");  Serial.println(epassword);
          strncpy(epassword, sarr[i+1], sizeof(epassword) - 1);   // len на 1 меньше размера буфера
          Serial.print(essid); Serial.print(" 1=> ");  Serial.println(epassword);
          result=true;
          break;
        }
      }



